{
  "name": "agentsofmine",
  "version": "0.1.1",
  "description": "Local MCP server that reads AI coding agent sessions and syncs to AgentsOfMine backend",
  "license": "MIT",
  "homepage": "https://agentsofmine.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AgentsOfMine/collector.git"
  },
  "bugs": {
    "url": "https://github.com/AgentsOfMine/collector/issues"
  },
  "keywords": [
    "ai-coding",
    "claude-code",
    "opencode",
    "codex",
    "mcp",
    "session-sync",
    "cli"
  ],
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "aom": "./dist/bin/aom.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "dev": "tsx src/index.ts",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "check": "npm run build && npm run lint && npm test",
    "prepare": "tsc",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^12.0.0",
    "commander": "^15.0.0",
    "keytar": "^7.9.0",
    "open": "^11.0.0",
    "qrcode-terminal": "^0.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.14.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "eslint": "^9.39.4",
    "tsx": "^4.15.7",
    "typescript": "^5.5.2",
    "vitest": "^1.6.0"
  }
}
