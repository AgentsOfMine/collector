---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { url } from "../site.config";
import { formatDate, isoDate } from "../lib/format";
import { CARDS, CARD_BASE } from "../lib/card-specs.mjs";
const pages = (await getCollection("docs")).filter((p) => p.data.kind !== "about").sort((a, b) => a.data.order - b.data.order);
---

<Base title="Ideas behind the AgentsOfMine collector" description="Notes and findings on the open-source AgentsOfMine collector: where AI coding agents keep their sessions, what gets uploaded, and what could be done better." path="/">
  <section class="max-w-[65ch]">
    <p class="aom-caption text-neutral-600 mb-3">Ideas</p>
    <h1 class="text-heading-l lg:text-display-xl text-text-primary">Ideas behind the AgentsOfMine collector</h1>
    <p class="mt-6 text-body-l text-neutral-400">
      A notebook for the open-source collector module, which reads the session files your AI coding agents already write to your disk. Each page is an idea or a finding: where those files are, what the collector sends, what could be done differently, and how to add an agent. Each page names what it was checked against and when.
    </p>
  </section>
  <section class="mt-12 max-w-[65ch]" aria-labelledby="pages">
    <h2 id="pages" class="text-heading-m text-text-primary mb-6">Notes</h2>
    <ul>
      {pages.map((p) => (
        <li class="py-6 border-b border-border-default first:pt-0">
          <a href={url(`/${p.data.slug}/`)} class="group flex flex-col gap-4 sm:flex-row sm:items-start sm:gap-6">
            {p.data.slug in CARDS && (
              <img
                src={`${CARD_BASE}/cards/${p.data.slug}-thumb.png`}
                alt=""
                width="640"
                height="360"
                loading="lazy"
                class="w-full sm:w-56 sm:order-last shrink-0 rounded-md border border-border-default"
              />
            )}
            <div class="min-w-0 flex-1">
              <h3 class="text-heading-s text-text-primary group-hover:underline underline-offset-4">{p.data.title}</h3>
              <p class="mt-2 text-body-s text-neutral-400">{p.data.description}</p>
              <p class="mt-2 text-caption text-neutral-600">Checked <time datetime={isoDate(p.data.verified)}>{formatDate(p.data.verified)}</time></p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>
